{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [],
  "redirects": [
    {
      "source": "/roofers",
      "destination": "/roofing",
      "permanent": true
    },
    {
      "source": "/med-spas",
      "destination": "/med-spa",
      "permanent": true
    },
    {
      "source": "/insurance",
      "destination": "/industries/ai-automation-for-insurance-agencies",
      "permanent": true
    },
    {
      "source": "/chiropractor",
      "destination": "/chiropractic",
      "permanent": true
    },
    {
      "source": "/tools/:path*",
      "destination": "/launchpad",
      "permanent": true
    },
    {
      "source": "/services/:path+",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/book-call",
      "destination": "/waitlist",
      "permanent": true
    },
    {
      "source": "/sign-in",
      "destination": "/waitlist",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
